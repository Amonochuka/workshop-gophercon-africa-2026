package components

import "workshop/internal/domain/species"

templ IntelPanel(animals []species.Animal) {
	<div class="intel-panel" id="intel-panel" role="dialog" aria-modal="true" aria-labelledby="intel-title" hidden>
		<div class="intel-backdrop" onclick="closeIntel()"></div>
		<div class="intel-modal">
			<header class="intel-header">
				<div class="intel-classification">
					<span class="intel-badge">CLASSIFIED</span>
					<span class="intel-level">LEVEL 3 // SPECIES INTEL</span>
				</div>
				<h2 id="intel-title" class="intel-title">SPECIES DOSSIER</h2>
				<button class="intel-close" onclick="closeIntel()" aria-label="Close">×</button>
			</header>
			
			<div class="intel-content" id="intel-content">
				<div class="intel-placeholder">
					<svg class="intel-scan" viewBox="0 0 100 100" aria-hidden="true">
						<circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
						<circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2"/>
						<circle cx="50" cy="50" r="15" fill="none" stroke="currentColor" stroke-width="1" opacity="0.1"/>
						<line x1="50" y1="0" x2="50" y2="100" stroke="currentColor" stroke-width="1" opacity="0.2"/>
						<line x1="0" y1="50" x2="100" y2="50" stroke="currentColor" stroke-width="1" opacity="0.2"/>
						<path class="scan-line" d="M10 50 Q50 30 90 50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
							<animate attributeName="stroke-dashoffset" from="0" to="300" dur="2s" repeatCount="indefinite"/>
						</path>
					</svg>
					<p class="intel-prompt">SELECT A TARGET FROM THE GRID</p>
					<p class="intel-sub">Click any animal card to load classified biological data</p>
				</div>
			</div>
			
			<footer class="intel-footer">
				<div class="intel-source">SOURCE: GBIF OCCURRENCE DATA // IUCN RED LIST // CITES</div>
				<div class="intel-timestamp" id="intel-timestamp">LAST UPDATED: <span id="timestamp-value">--</span></div>
			</footer>
		</div>
	</div>
	
	<script>
		const INTEL_DATA = {};
		(function initIntelData() {
			// Populated by Go template
		})();
	</script>
}