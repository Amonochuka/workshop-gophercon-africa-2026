package components

import (
	"cmp"
	"fmt"
	"slices"
	"strings"

	"workshop/internal/domain/sighting"
	"workshop/internal/domain/species"
)

templ SightingCard(s sighting.Sighting) {
	{{ call := callOf(s.Species) }}
	<article class={ "card", "card--" + call.Motion } id={ Anchor(s) } data-call={ call.Sound }>
		<span class="card__ripple" aria-hidden="true"></span>
		<span class="card__hint" aria-hidden="true">Click to hear it</span>
		<div class="card__photo">
			if m, ok := firstPhoto(s.Media); ok {
				<a class="card__zoom" href={ templ.URL(m.URL) } data-lightbox data-caption={ photoCaption(s, m) }>
					<img src={ m.URL } alt={ "A " + displayName(s.Species) + ": " + altText(m) } loading="lazy"/>
				</a>
				if m.Creator != "" {
					<span class="card__credit">© { m.Creator }</span>
				}
			} else {
				<span class="card__nophoto" aria-hidden="true">No photo, just eyes in the dark</span>
			}
		</div>
		<div class="card__body">
			<p class="card__date">
				<time datetime={ s.HappenedAt.Format("2006-01-02") }>{ s.HappenedAt.Format("2 January 2006") }</time>
			</p>
			<h3 class="card__name">{ displayName(s.Species) }</h3>
			if s.Species.ScientificName != "" {
				<p class="card__scientific">{ s.Species.ScientificName }</p>
			}
			<dl class="card__meta">
				<dt>Where</dt>
				<dd>{ place(s.Location) }</dd>
				if s.IndividualCount != nil {
					<dt>Count</dt>
					<dd>{ individuals(*s.IndividualCount) }</dd>
				}
				if s.RecordedBy != "" {
					<dt>Seen by</dt>
					<dd>{ s.RecordedBy }</dd>
				}
			</dl>
		</div>
	</article>
}

// displayName prefers the name a reader would recognise, falling back
// through the taxonomy as GBIF records thin out.
func displayName(sp species.Species) string {
	return cmp.Or(sp.VernacularName, sp.CanonicalName, sp.ScientificName, "Unknown species")
}

// place joins whichever parts of the location GBIF supplied.
func place(l sighting.Location) string {
	parts := slices.DeleteFunc(
		[]string{l.Locality, l.StateProvince, l.Country},
		func(s string) bool { return s == "" },
	)
	return cmp.Or(strings.Join(parts, ", "), "Location unknown")
}

// individuals renders how many animals were seen in a single sighting.
func individuals(n int) string {
	if n == 1 {
		return "1 individual"
	}
	return fmt.Sprintf("%d individuals", n)
}
